[Unit]
Description=FrankenFile private file drops
Documentation=file:/usr/share/doc/frankenfile/deployment.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/frankenfile

[Service]
Type=simple
User=frankenfile
Group=frankenfile
WorkingDirectory=/var/lib/frankenfile
StateDirectory=frankenfile
StateDirectoryMode=2770
UMask=0007
Environment=RUST_LOG=frankenfile=info,tower_http=info
# Holds FRANKENFILE_ADMIN_PASSWORD=... at mode 0640, root:frankenfile.
# Without it the console password is regenerated on every restart.
EnvironmentFile=-/etc/frankenfile/frankenfile.env
# Edit --bind, --base-path, --public-url and --trusted-proxy for this host. The
# public URL must end with the base path, and the bind address must not be
# reachable from the Internet: only the TLS reverse proxy should reach it.
ExecStart=/usr/local/bin/frankenfile --data-dir /var/lib/frankenfile serve \
  --bind 127.0.0.1:18766 \
  --base-path /frankenfile \
  --public-url https://files.example.com/frankenfile \
  --trusted-proxy 127.0.0.1/32 \
  --global-failure-limit 10 \
  --source-failure-limit 5 \
  --session-ttl 24h
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536
TasksMax=256

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
