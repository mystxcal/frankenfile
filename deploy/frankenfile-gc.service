[Unit]
Description=FrankenFile retention and garbage collection
After=frankenfile.service

[Service]
Type=oneshot
User=frankenfile
Group=frankenfile
StateDirectory=frankenfile
StateDirectoryMode=2770
UMask=0007
ExecStart=/usr/local/bin/frankenfile --data-dir /var/lib/frankenfile gc --execute --retention 7d
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
